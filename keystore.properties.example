# Release signing config template.
#
# Copy this file to `keystore.properties` (same folder as this file) and fill in
# your own values to sign the RELEASE build of each app with your own key.
#
#   cp keystore.properties.example keystore.properties
#
# `keystore.properties` and `*.keystore` / `*.jks` are git-ignored, so your
# secrets never get committed. Without this file, release builds fall back to
# the debug key — the APK still installs, but is not production-signed.
#
# Generate a key once with:
#   keytool -genkeypair -v -keystore release.keystore \
#     -alias my-release -keyalg RSA -keysize 2048 -validity 10000

storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=my-release
keyPassword=CHANGE_ME
